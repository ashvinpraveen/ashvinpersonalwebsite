# Convex deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-dev-deployment

# Public Convex URL used by the Next.js client
NEXT_PUBLIC_CONVEX_URL=https://your-dev-deployment.convex.cloud

# Public Convex HTTP Actions URL used by `/cleve-proxy`
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-dev-deployment.convex.site

# Optional public feature flags. Set any of these to false to hide a service-backed feature.
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_CHAT_BACKEND=legacy
NEXT_PUBLIC_ENABLE_POSTCARDS=true
NEXT_PUBLIC_ENABLE_RUN_CLUB=true
NEXT_PUBLIC_ENABLE_MUSIC=true
NEXT_PUBLIC_ENABLE_POSTHOG=true

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key

# Convex server env vars for AI chat.
# Set these with `npx convex env set`, not as public Next.js variables.
ILMU_API_KEY=your-ilmu-api-key
ILMU_MODEL=ilmu-mini-v3.3
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key
GOOGLE_AI_MODEL=gemini-2.5-flash

# Convex server env vars for Cal.com booking.
CAL_API_KEY=your-cal-com-api-key
CAL_USERNAME=ashvinpraveen
CAL_EVENT_TYPE_SLUG=15min
CAL_BOOKING_LINK=https://cal.com/ashvinpraveen/15min

# Convex server env vars for Music studio Suno polish (optional).
# Get a key from a Suno API provider such as https://api.sunoapi.org
SUNO_API_KEY=your-suno-api-key
SUNO_MODEL=V4_5ALL
