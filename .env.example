# Convex deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-dev-deployment

# Public Convex URL used by the Next.js client
NEXT_PUBLIC_CONVEX_URL=https://your-dev-deployment.convex.cloud

# Public Convex HTTP Actions URL used by `/cleve-proxy`
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-dev-deployment.convex.site

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
